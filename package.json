{
  "name": "agentic-sales",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "import": "node server/import.mjs",
    "server": "node server/import.mjs && node server/server.mjs",
    "dev": "concurrently -n server,agent,client -c blue,magenta,green \"npm run server\" \"npm run agent\" \"npm run start\"",
    "agent": "npm --prefix agent run dev"
  },
  "private": true,
  "packageManager": "npm@11.18.0",
  "dependencies": {
    "@ag-ui/client": "^0.0.59",
    "@ag-ui/core": "^0.0.59",
    "@angular/cdk": "~22.1.3",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@copilotkit/angular": "^0.5.2",
    "@duckdb/node-api": "^1.5.5-r.4",
    "chart.js": "^4.5.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "concurrently": "^10.0.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "rxjs": "$rxjs"
  }
}
