{
  "name": "agentic-sales",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "npm run dev",
    "client": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "import": "node server/data/import.ts",
    "server": "node server/data/import.ts && node --watch server/server.ts",
    "server:typecheck": "tsc -p server/tsconfig.json",
    "mcp-server": "node --watch mcp-server/server.ts",
    "mcp-server:widget": "vite build --watch --config mcp-server/vite.config.ts",
    "mcp-server:typecheck": "tsc -p mcp-server/tsconfig.json",
    "agent": "mastra dev --dir agent/src/mastra --env .env",
    "agent:typecheck": "tsc -p agent/tsconfig.json",
    "dev": "concurrently -n server,mcp-server,mcp-widget,agent,client -c blue,yellow,cyan,magenta,green \"npm run server\" \"npm run mcp-server\" \"npm run mcp-server:widget\" \"npm run agent\" \"npm run client\"",
    "lint": "ng lint",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@11.18.0",
  "dependencies": {
    "@a2ui/web_core": "0.10.4",
    "@ag-ui/a2ui-middleware": "^0.0.12",
    "@ag-ui/a2ui-toolkit": "^0.0.5",
    "@ag-ui/client": "^1.0.2",
    "@ag-ui/core": "^1.0.2",
    "@ag-ui/mastra": "^1.1.6",
    "@ag-ui/mcp-apps-middleware": "^0.1.2",
    "@angular/cdk": "~22.1.3",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@copilotkit/a2ui-renderer": "1.70.2",
    "@copilotkit/angular": "^0.5.3",
    "@duckdb/node-api": "^1.5.5-r.4",
    "@mastra/core": "^1.61.0",
    "@mastra/libsql": "^1.25.1",
    "@mastra/memory": "^1.36.0",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "chart.js": "^4.5.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "hono": "~4.13.4",
    "jsonata": "^2.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "angular-eslint": "22.5.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.5.1",
    "mastra": "^1.26.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "8.1.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "rxjs": "$rxjs",
    "@copilotkit/runtime": "file:./agent/libs/copilotkit-runtime-stub"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
